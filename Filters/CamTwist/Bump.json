{
  "NAME": "Bump",
  "CATEGORIES": ["CamTwist", "Distortion"],
  "DESCRIPTION": "A bulge (or dent) in the picture (CIBumpDistortion). Drag on the preview to move it.",
  "INPUTS": [
    { "NAME": "center", "LABEL": "Center", "TYPE": "point2D", "DEFAULT": [0.5, 0.45] },
    { "NAME": "radius", "LABEL": "Radius", "TYPE": "float", "DEFAULT": 0.35, "MIN": 0.05, "MAX": 1 },
    { "NAME": "scale", "LABEL": "Scale", "TYPE": "float", "DEFAULT": 0.6, "MIN": -1, "MAX": 1 }
  ],
  "GRAPH": [
    { "ID": "bump", "FILTER": "CIBumpDistortion", "INPUTS": { "inputImage": "$input", "inputCenter": "%center", "inputRadius": "=radius * HEIGHT", "inputScale": "=scale" } }
  ]
}
