{
  "NAME": "Unsharp Mask",
  "CATEGORIES": [
    "Blur",
    "Core Image"
  ],
  "DESCRIPTION": "Classic unsharp-mask sharpening (CIUnsharpMask).",
  "INPUTS": [
    {
      "NAME": "radius",
      "LABEL": "Radius",
      "TYPE": "float",
      "DEFAULT": 2.5,
      "MIN": 0,
      "MAX": 20
    },
    {
      "NAME": "intensity",
      "LABEL": "Intensity",
      "TYPE": "float",
      "DEFAULT": 0.5,
      "MIN": 0,
      "MAX": 2
    }
  ],
  "GRAPH": [
    {
      "ID": "clamped",
      "FILTER": "CIAffineClamp",
      "INPUTS": {
        "inputImage": "$input",
        "inputTransform": {
          "TRANSFORM": {}
        }
      }
    },
    {
      "ID": "fx",
      "FILTER": "CIUnsharpMask",
      "INPUTS": {
        "inputImage": "@clamped",
        "inputRadius": "=radius",
        "inputIntensity": "=intensity"
      }
    }
  ],
  "OUTPUT": "@fx"
}
