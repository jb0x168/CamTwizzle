{
  "NAME": "Zoom Blur",
  "CATEGORIES": [
    "Blur",
    "Core Image"
  ],
  "DESCRIPTION": "Rushing-forward radial blur (CIZoomBlur).",
  "INPUTS": [
    {
      "NAME": "center",
      "LABEL": "Center",
      "TYPE": "point2D",
      "DEFAULT": [
        0.5,
        0.5
      ]
    },
    {
      "NAME": "amount",
      "LABEL": "Amount %",
      "TYPE": "float",
      "DEFAULT": 4,
      "MIN": 0,
      "MAX": 20
    }
  ],
  "GRAPH": [
    {
      "ID": "clamped",
      "FILTER": "CIAffineClamp",
      "INPUTS": {
        "inputImage": "$input",
        "inputTransform": {
          "TRANSFORM": {}
        }
      }
    },
    {
      "ID": "fx",
      "FILTER": "CIZoomBlur",
      "INPUTS": {
        "inputImage": "@clamped",
        "inputCenter": "%center",
        "inputAmount": "=amount * HEIGHT / 100"
      }
    }
  ],
  "OUTPUT": "@fx"
}
