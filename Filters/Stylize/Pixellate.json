{
  "NAME": "Pixellate",
  "CATEGORIES": [
    "Stylize",
    "Core Image"
  ],
  "DESCRIPTION": "Big square pixels (CIPixellate).",
  "INPUTS": [
    {
      "NAME": "scale",
      "LABEL": "Pixel Size %",
      "TYPE": "float",
      "DEFAULT": 3,
      "MIN": 0.5,
      "MAX": 15
    },
    {
      "NAME": "center",
      "LABEL": "Center",
      "TYPE": "point2D",
      "DEFAULT": [
        0.5,
        0.5
      ]
    }
  ],
  "GRAPH": [
    {
      "ID": "fx",
      "FILTER": "CIPixellate",
      "INPUTS": {
        "inputImage": "$input",
        "inputCenter": "%center",
        "inputScale": "=scale * HEIGHT / 100"
      }
    }
  ],
  "OUTPUT": "@fx"
}
