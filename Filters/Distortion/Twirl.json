{
  "NAME": "Twirl",
  "CATEGORIES": [
    "Distortion",
    "Core Image"
  ],
  "DESCRIPTION": "Swirl the picture around a point (CITwirlDistortion).",
  "INPUTS": [
    {
      "NAME": "center",
      "LABEL": "Center",
      "TYPE": "point2D",
      "DEFAULT": [
        0.5,
        0.5
      ]
    },
    {
      "NAME": "radius",
      "LABEL": "Radius",
      "TYPE": "float",
      "DEFAULT": 0.45,
      "MIN": 0.05,
      "MAX": 1.5
    },
    {
      "NAME": "angle",
      "LABEL": "Angle",
      "TYPE": "float",
      "DEFAULT": 200,
      "MIN": -720,
      "MAX": 720
    },
    {
      "NAME": "wobble",
      "LABEL": "Wobble Speed",
      "TYPE": "float",
      "DEFAULT": 0,
      "MIN": 0,
      "MAX": 3
    }
  ],
  "GRAPH": [
    {
      "ID": "clamped",
      "FILTER": "CIAffineClamp",
      "INPUTS": {
        "inputImage": "$input",
        "inputTransform": {
          "TRANSFORM": {}
        }
      }
    },
    {
      "ID": "fx",
      "FILTER": "CITwirlDistortion",
      "INPUTS": {
        "inputImage": "@clamped",
        "inputCenter": "%center",
        "inputRadius": "=radius * HEIGHT",
        "inputAngle": "=angle * PI / 180 + sin(TIME * wobble) * 2"
      }
    }
  ],
  "OUTPUT": "@fx"
}
