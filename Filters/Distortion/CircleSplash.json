{
  "NAME": "Circle Splash",
  "CATEGORIES": [
    "Distortion",
    "Core Image"
  ],
  "DESCRIPTION": "Streaks radiating out of a circle (CICircleSplashDistortion).",
  "INPUTS": [
    {
      "NAME": "center",
      "LABEL": "Center",
      "TYPE": "point2D",
      "DEFAULT": [
        0.5,
        0.5
      ]
    },
    {
      "NAME": "radius",
      "LABEL": "Radius",
      "TYPE": "float",
      "DEFAULT": 0.3,
      "MIN": 0.05,
      "MAX": 1
    }
  ],
  "GRAPH": [
    {
      "ID": "clamped",
      "FILTER": "CIAffineClamp",
      "INPUTS": {
        "inputImage": "$input",
        "inputTransform": {
          "TRANSFORM": {}
        }
      }
    },
    {
      "ID": "fx",
      "FILTER": "CICircleSplashDistortion",
      "INPUTS": {
        "inputImage": "@clamped",
        "inputCenter": "%center",
        "inputRadius": "=radius * HEIGHT"
      }
    }
  ],
  "OUTPUT": "@fx"
}
