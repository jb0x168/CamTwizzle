{
  "NAME": "Hole",
  "CATEGORIES": [
    "Distortion",
    "Core Image"
  ],
  "DESCRIPTION": "Punch a hole that pushes the picture outward (CIHoleDistortion).",
  "INPUTS": [
    {
      "NAME": "center",
      "LABEL": "Center",
      "TYPE": "point2D",
      "DEFAULT": [
        0.5,
        0.5
      ]
    },
    {
      "NAME": "radius",
      "LABEL": "Radius",
      "TYPE": "float",
      "DEFAULT": 0.12,
      "MIN": 0.01,
      "MAX": 0.5
    }
  ],
  "GRAPH": [
    {
      "ID": "clamped",
      "FILTER": "CIAffineClamp",
      "INPUTS": {
        "inputImage": "$input",
        "inputTransform": {
          "TRANSFORM": {}
        }
      }
    },
    {
      "ID": "fx",
      "FILTER": "CIHoleDistortion",
      "INPUTS": {
        "inputImage": "@clamped",
        "inputCenter": "%center",
        "inputRadius": "=radius * HEIGHT"
      }
    }
  ],
  "OUTPUT": "@fx"
}
