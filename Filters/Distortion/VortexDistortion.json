{
  "NAME": "Whirlpool",
  "CATEGORIES": [
    "Distortion",
    "Core Image"
  ],
  "DESCRIPTION": "Deep rotational vortex (CIVortexDistortion).",
  "INPUTS": [
    {
      "NAME": "center",
      "LABEL": "Center",
      "TYPE": "point2D",
      "DEFAULT": [
        0.5,
        0.5
      ]
    },
    {
      "NAME": "radius",
      "LABEL": "Radius",
      "TYPE": "float",
      "DEFAULT": 0.5,
      "MIN": 0.05,
      "MAX": 1.5
    },
    {
      "NAME": "angle",
      "LABEL": "Angle",
      "TYPE": "float",
      "DEFAULT": 560,
      "MIN": -2000,
      "MAX": 2000
    }
  ],
  "GRAPH": [
    {
      "ID": "clamped",
      "FILTER": "CIAffineClamp",
      "INPUTS": {
        "inputImage": "$input",
        "inputTransform": {
          "TRANSFORM": {}
        }
      }
    },
    {
      "ID": "fx",
      "FILTER": "CIVortexDistortion",
      "INPUTS": {
        "inputImage": "@clamped",
        "inputCenter": "%center",
        "inputRadius": "=radius * HEIGHT",
        "inputAngle": "=angle"
      }
    }
  ],
  "OUTPUT": "@fx"
}
