{
  "NAME": "Triangle Kaleidoscope",
  "CATEGORIES": [
    "Geometry",
    "Core Image"
  ],
  "DESCRIPTION": "Triangular mirror tiles (CITriangleKaleidoscope).",
  "INPUTS": [
    {
      "NAME": "size",
      "LABEL": "Size %",
      "TYPE": "float",
      "DEFAULT": 40,
      "MIN": 5,
      "MAX": 100
    },
    {
      "NAME": "rotation",
      "LABEL": "Rotation",
      "TYPE": "float",
      "DEFAULT": 0,
      "MIN": 0,
      "MAX": 360
    },
    {
      "NAME": "spin",
      "LABEL": "Spin",
      "TYPE": "float",
      "DEFAULT": 0.2,
      "MIN": -1,
      "MAX": 1
    },
    {
      "NAME": "decay",
      "LABEL": "Decay",
      "TYPE": "float",
      "DEFAULT": 0.85,
      "MIN": 0,
      "MAX": 1
    },
    {
      "NAME": "center",
      "LABEL": "Center",
      "TYPE": "point2D",
      "DEFAULT": [
        0.5,
        0.5
      ]
    }
  ],
  "GRAPH": [
    {
      "ID": "clamped",
      "FILTER": "CIAffineClamp",
      "INPUTS": {
        "inputImage": "$input",
        "inputTransform": {
          "TRANSFORM": {}
        }
      }
    },
    {
      "ID": "fx",
      "FILTER": "CITriangleKaleidoscope",
      "INPUTS": {
        "inputImage": "@clamped",
        "inputPoint": "%center",
        "inputSize": "=size * HEIGHT / 100",
        "inputRotation": "=rotation * PI / 180 + TIME * spin",
        "inputDecay": "=decay"
      }
    }
  ],
  "OUTPUT": "@fx"
}
